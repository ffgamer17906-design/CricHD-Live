<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pro Cricket Live - Get the latest cricket scores, news, player stats, and match highlights.">
    <meta property="og:title" content="Pro Cricket Live | Live Scores & Updates">
    <meta property="og:description" content="Premium destination for real-time cricket updates and expert analysis.">
    <meta property="og:type" content="website">
    <title>Pro Cricket Live | Home</title>
    
    <!-- Tailwind CSS (CDN for instant deployment) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { primary: '#1e3a8a', accent: '#38bdf8', darkBg: '#0f172a' }
                }
            }
        }
    </script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/responsive.css">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-darkBg dark:text-gray-100 transition-colors duration-300">

    <!-- Loading Screen -->
    <div id="loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white dark:bg-darkBg">
        <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-accent border-solid"></div>
    </div>

    <!-- Navigation -->
    <nav class="sticky top-0 z-40 w-full glass-nav px-6 py-4 flex justify-between items-center transition-all">
        <a href="index.html" class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary to-accent" aria-label="Home">
            🏏 ProCricket
        </a>
        
        <div class="hidden md:flex space-x-6 items-center">
            <a href="index.html" class="hover:text-accent font-semibold transition">Home</a>
            <a href="live.html" class="hover:text-accent font-semibold transition flex items-center gap-1">
                <span class="live-indicator"></span>Live
            </a>
            <a href="#" class="hover:text-accent font-semibold transition">Matches</a>
            <a href="#" class="hover:text-accent font-semibold transition">Teams</a>
            <a href="#" class="hover:text-accent font-semibold transition">News</a>
            
            <button id="theme-toggle" class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition" aria-label="Toggle Dark Mode">
                <i class="fas fa-moon dark:hidden"></i>
                <i class="fas fa-sun hidden dark:block text-yellow-400"></i>
            </button>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="relative w-full h-[60vh] flex items-center justify-center text-center overflow-hidden bg-gradient-to-br from-primary to-blue-900 text-white">
        <div class="absolute inset-0 bg-black opacity-40"></div>
        <div class="relative z-10 px-4 slide-up">
            <h1 class="text-5xl md:text-7xl font-extrabold mb-4">Feel The Game</h1>
            <p class="text-lg md:text-2xl mb-8 text-gray-200">Live scores, premium statistics, and unrivaled coverage.</p>
            <div class="flex justify-center gap-4">
                <a href="live.html" class="bg-accent hover:bg-sky-400 text-white px-8 py-3 rounded-full font-bold shadow-lg transform hover:-translate-y-1 transition">Live Scores</a>
                <a href="#" class="glass-card px-8 py-3 rounded-full font-bold hover:bg-white hover:text-primary transition">View Schedule</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-12">
        
        <!-- Live Matches Section -->
        <section class="mb-16">
            <h2 class="text-3xl font-bold mb-6 flex items-center gap-2"><i class="fas fa-broadcast-tower text-accent"></i> Featured Matches</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Match Card 1 -->
                <a href="live.html" class="glass-card rounded-2xl p-6 hover-lift block">
                    <div class="flex justify-between items-center border-b border-gray-200 dark:border-gray-700 pb-3 mb-3">
                        <span class="text-xs font-bold text-red-500 uppercase tracking-wider flex items-center gap-1"><span class="live-indicator"></span> LIVE</span>
                        <span class="text-xs text-gray-500 dark:text-gray-400">T20 World Cup - Final</span>
                    </div>
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-xs">IND</div>
                            <span class="font-bold text-xl">176/7</span>
                        </div>
                        <span class="text-sm text-gray-500">v</span>
                        <div class="flex items-center gap-3">
                            <span class="font-bold text-xl">169/8</span>
                            <div class="w-8 h-8 rounded-full bg-green-600 flex items-center justify-center text-white font-bold text-xs">SA</div>
                        </div>
                    </div>
                    <p class="text-sm font-semibold text-accent text-center">India won by 7 runs</p>
                </a>
            </div>
        </section>

        <!-- News Section -->
        <section class="mb-16">
            <h2 class="text-3xl font-bold mb-6 flex items-center gap-2"><i class="far fa-newspaper text-accent"></i> Trending News</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <article class="bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-lg hover-lift">
                    <div class="h-48 bg-gray-300 dark:bg-gray-700 w-full flex items-center justify-center text-gray-500"><i class="fas fa-image text-3xl"></i></div>
                    <div class="p-6">
                        <span class="text-xs font-bold text-accent uppercase tracking-wider">Tournament</span>
                        <h3 class="text-xl font-bold mt-2 mb-3">Squad Announced for Upcoming Test Series</h3>
                        <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">The selection committee has finalized the 15-man squad, introducing two uncapped players to the national side.</p>
                        <a href="#" class="text-primary dark:text-accent font-semibold hover:underline">Read More &rarr;</a>
                    </div>
                </article>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white pt-12 pb-6 border-t border-gray-800">
        <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
            <div>
                <h3 class="text-2xl font-bold text-accent mb-4">🏏 ProCricket</h3>
                <p class="text-gray-400 text-sm">Your ultimate destination for live cricket scores, comprehensive statistics, and expert news coverage.</p>
            </div>
            <div>
                <h4 class="font-bold mb-4">Quick Links</h4>
                <ul class="space-y-2 text-gray-400 text-sm">
                    <li><a href="#" class="hover:text-accent transition">Home</a></li>
                    <li><a href="live.html" class="hover:text-accent transition">Live Scores</a></li>
                    <li><a href="#" class="hover:text-accent transition">Schedule</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-4">Legal</h4>
                <ul class="space-y-2 text-gray-400 text-sm">
                    <li><a href="#" class="hover:text-accent transition">Privacy Policy</a></li>
                    <li><a href="#" class="hover:text-accent transition">Terms of Service</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-4">Follow Us</h4>
                <div class="flex space-x-4">
                    <a href="#" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-accent transition" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-accent transition" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-accent transition" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>
        <div class="text-center text-gray-500 text-sm border-t border-gray-800 pt-6">
            &copy; 2026 Pro Cricket Live. All rights reserved. Built for GitHub Pages.
        </div>
    </footer>

    <!-- Back to Top Button -->
    <button id="back-to-top" class="fixed bottom-6 right-6 bg-accent text-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center opacity-0 invisible transition-all duration-300 hover:bg-sky-400 z-50" aria-label="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script src="js/theme.js"></script>
    <script src="js/app.js"></script>
</body>
</html>
